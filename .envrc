#!/usr/bin/env bash

eval "$(devenv direnvrc)"

# devenv's watch helper uses Bash namerefs, unavailable in macOS Bash 3.2.
_devenv_watches() {
    local path=$1 file
    if [[ -f "$path" ]]; then
        while IFS= read -r file; do
            watch_file "$file"
        done <"$path"
    fi
}

use devenv
