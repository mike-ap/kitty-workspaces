{
  "config": {
    "default": true,
    // Prose is soft-wrapped; shell commands and compatibility tables can be long.
    "MD013": false,
    // Changelogs repeat Added/Changed/Fixed within different release sections.
    "MD024": { "siblings_only": true }
  },
  "globs": ["**/*.md"],
  "ignores": ["TokenEconomizer/**", "htmlcov/**", "dist/**", ".venv/**", ".devenv/**", ".direnv/**", ".git/**"]
}
